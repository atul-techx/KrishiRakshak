# Copy this file to .env for LOCAL server use only. Never upload .env to a static host.
GEMINI_API_KEY=
KINDWISE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# A hosting provider can supply PORT and HOST through its environment.
# PORT=3000
# HOST=127.0.0.1
# Separate frontend only: comma-separated exact website origins.
ALLOWED_ORIGINS=
